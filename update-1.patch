+  "$HERE/pull_task_images.sh" "$OUT" "$IMAGES" "$CACHE" "$ID" ||
+    die "no image for $ID; nothing recorded. Fix the pull (see the log above) and run again."
 else
   "$HERE/warm_dependencies.sh" "$T" "$CACHE" "$IMAGES"
 fi
