diff --git a/scripts/check_setup.sh b/scripts/check_setup.sh
index 452e7c4..e17f820 100755
--- a/scripts/check_setup.sh
+++ b/scripts/check_setup.sh
@@ -37,6 +37,34 @@ if (( FREE >= 300 )); then ok "free disk at $RB_WORK: ${FREE} GB"
 elif (( FREE >= 10 )); then warn "free disk at $RB_WORK: ${FREE} GB (enough for a first try with a few tasks)" \
   "all 250 frozen images + the 4 models need several hundred GB; later set RB_WORK to a bigger disk"
 else fail "only ${FREE} GB free at $RB_WORK" "set RB_WORK to a disk with more space and re-source scripts/env.sh"; fi
+# Apptainer unpacks image layers in APPTAINER_TMPDIR; real images contain names like ":.1.gz"
+# that some network file systems reject ("invalid argument" during the pull).
+NAMES_OK=$(python3 - "$APPTAINER_TMPDIR" <<'EOF'
+import os, sys, tempfile
+d = tempfile.mkdtemp(dir=sys.argv[1])
+bad = []
+for n in [":.1.gz", "a:b", "x?y", "back\\slash", "trail.", "CON"]:
+    try:
+        open(os.path.join(d, n), "w").close()
+    except OSError:
+        bad.append(n)
+for n in os.listdir(d):
+    os.unlink(os.path.join(d, n))
+os.rmdir(d)
+print(" ".join(bad))
+EOF
+)
+TFREE=$(python3 -c 'import shutil,sys; print(shutil.disk_usage(sys.argv[1]).free // 2**30)' "$APPTAINER_TMPDIR" 2>/dev/null || echo 0)
+if [[ -n $NAMES_OK ]]; then
+  fail "APPTAINER_TMPDIR=$APPTAINER_TMPDIR rejects file names used inside images: $NAMES_OK" \
+       "pulls fail with 'invalid argument'; use a local disk: export APPTAINER_TMPDIR=/tmp/\$USER/apptainer-tmp"
+  need frozen no
+elif (( TFREE < 10 )); then
+  warn "only ${TFREE} GB free in APPTAINER_TMPDIR=$APPTAINER_TMPDIR (images are unpacked there while pulling)" \
+       "pick a local disk with 10-20 GB free: export APPTAINER_TMPDIR=<dir>"
+else
+  ok "APPTAINER_TMPDIR=$APPTAINER_TMPDIR accepts image file names, ${TFREE} GB free"
+fi
 if have unshare && unshare -rn true 2>/dev/null; then ok "user namespaces allowed (tests/e2e_fake.sh can cut the network)"
 else warn "user namespaces not allowed for this user" "tests/e2e_fake.sh will run, but its leak self-test check fails on purpose"; fi
 
diff --git a/scripts/env.sh b/scripts/env.sh
index e6f5c8a..89399f8 100755
--- a/scripts/env.sh
+++ b/scripts/env.sh
@@ -3,18 +3,34 @@
 # For a first try everything lives in ./work inside the repository. To put the large files
 # (images, caches, model weights) somewhere else later, set RB_WORK before sourcing:
 #   RB_WORK=/big/disk/rb source scripts/env.sh
-# Any single variable that is already set is kept as it is.
+# A variable that is already set is kept, unless its folder can't be created; then it is
+# reset to the default and a warning says so (e.g. an old export to a missing /scratch).
 # shellcheck shell=bash
 RB_REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
 export RB_REPO
-export RB_WORK=${RB_WORK:-$RB_REPO/work}
-export IMAGES=${IMAGES:-$RB_WORK/images}                 # .sif images
-export CACHE=${CACHE:-$RB_WORK/cache}                    # Maven/Gradle caches
-export MODELS_ROOT=${MODELS_ROOT:-$RB_WORK/models}       # model weights
+
+_rb_dir() {  # _rb_dir <VAR> <default> : keep $VAR if usable, else use the default
+  local name=$1 default=$2 value=${!1:-}
+  if [[ -n $value ]] && ! mkdir -p "$value" 2>/dev/null; then
+    echo "warning: $name=$value can't be created; using $default instead" >&2
+    value=""
+  fi
+  value=${value:-$default}
+  mkdir -p "$value" || { echo "error: can't create $value for $name" >&2; return 1; }
+  export "$name=$value"
+}
+
+_rb_dir RB_WORK "$RB_REPO/work"
+_rb_dir IMAGES "$RB_WORK/images"                   # .sif images
+_rb_dir CACHE "$RB_WORK/cache"                     # Maven/Gradle caches
+_rb_dir MODELS_ROOT "$RB_WORK/models"              # model weights
+_rb_dir APPTAINER_CACHEDIR "$RB_WORK/apptainer-cache"
+# Apptainer unpacks images here while pulling. Keep it on a LOCAL disk: network file
+# systems (e.g. some home/NFS/SMB mounts) reject file names such as ":.1.gz" that real
+# images contain, and the pull then fails with "invalid argument".
+_rb_dir APPTAINER_TMPDIR "${TMPDIR:-/tmp}/${USER:-rb}-rb-apptainer-tmp"
+_rb_dir OUT "$RB_REPO/out"                         # task folders
+_rb_dir RUNS "$RB_REPO/runs"                       # agent runs and results
 export VLLM_SIF=${VLLM_SIF:-$IMAGES/vllm.sif}
-export APPTAINER_CACHEDIR=${APPTAINER_CACHEDIR:-$RB_WORK/apptainer-cache}
-export APPTAINER_TMPDIR=${APPTAINER_TMPDIR:-$RB_WORK/tmp}
-export OUT=${OUT:-$RB_REPO/out}                          # task folders
-export RUNS=${RUNS:-$RB_REPO/runs}                       # agent runs and results
-mkdir -p "$IMAGES" "$CACHE" "$MODELS_ROOT" "$APPTAINER_CACHEDIR" "$APPTAINER_TMPDIR"
+unset -f _rb_dir
 echo "RB_WORK=$RB_WORK  (images, caches, models)   OUT=$OUT   RUNS=$RUNS"
