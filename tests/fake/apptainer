#!/usr/bin/env python3
"""A stand-in for `apptainer`, used only by tests/e2e_fake.sh.

Supports the subset the scripts use (exec, instance start/stop) and emulates the two
properties that matter: bind mounts and `--net --network none`.

Modes, chosen automatically (override with FAKE_APPTAINER_MODE):
  mount      root: real `mount --bind` in a private mount namespace (+ empty net namespace)
  translate  normal user: container paths (/work, /cache, ...) are rewritten to the host
             paths in arguments and environment; the network is cut with `unshare -rn`
             when unprivileged user namespaces are allowed
  plain      like translate, but without network isolation (last resort)
The "image" is ignored: commands run with the host's tools, with tests/fake/bin first in
PATH (login shells are run as non-login shells so PATH is kept).
"""
import json
import os
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

STATE = Path(os.environ.get("FAKE_APPTAINER_STATE", "/tmp/fake-apptainer"))
STATE.mkdir(parents=True, exist_ok=True)
VALUE_OPTS = {"--bind", "-B", "--env", "--pwd", "--network", "--build-arg"}
FLAG_OPTS = {"--net", "--containall", "--no-home", "--nv", "--fakeroot", "--force", "--cleanenv"}
FAKE_BIN = str(Path(__file__).resolve().parent / "bin")


def works(cmd):
    return subprocess.run(cmd, capture_output=True).returncode == 0


def mode():
    m = os.environ.get("FAKE_APPTAINER_MODE")
    if m:
        return m
    if os.geteuid() == 0 and works(["unshare", "-m", "true"]):
        return "mount"
    return "translate" if works(["unshare", "-rn", "true"]) else "plain"


def parse(args):
    opts = {"bind": [], "env": [], "pwd": None, "nonet": False}
    i = 0
    while i < len(args) and args[i].startswith("-"):
        a = args[i]
        if a in VALUE_OPTS:
            v = args[i + 1]; i += 2
            if a in ("--bind", "-B"):
                opts["bind"].append(v)
            elif a == "--env":
                opts["env"].append(v)
            elif a == "--pwd":
                opts["pwd"] = v
            elif a == "--network" and v == "none":
                opts["nonet"] = True
        elif a in FLAG_OPTS:
            i += 1
        else:
            sys.exit(f"fake apptainer: unsupported option {a}")
    return opts, args[i:]


def no_login(cmd):
    # `bash -lc` would reset PATH from /etc/profile on some systems and lose the fake tools
    if len(cmd) >= 2 and cmd[0] == "bash" and cmd[1] == "-lc":
        return ["bash", "-c"] + cmd[2:]
    return cmd


def run_mount(opts, cmd):
    script = ["set -e"]
    for b in opts["bind"]:
        src, dst = b.split(":")[:2]
        script.append(f"mkdir -p {shlex.quote(dst)} && mount --bind {shlex.quote(src)} {shlex.quote(dst)}")
        if b.endswith(":ro"):
            script.append(f"mount -o remount,bind,ro {shlex.quote(dst)}")
    exports = " ".join(f"export {shlex.quote(e)};" for e in opts["env"])
    script.append(f"export PATH={shlex.quote(FAKE_BIN)}:$PATH; {exports} "
                  f"cd {shlex.quote(opts['pwd'] or '/')} && exec \"$@\"")
    unshare = ["unshare", "-m", "--propagation", "private"] + (["-n"] if opts["nonet"] else [])
    return subprocess.call(unshare + ["bash", "-c", "\n".join(script), "fake"] + cmd)


def run_translate(opts, cmd, isolate_net):
    pairs = []
    for b in opts["bind"]:
        src, dst = b.split(":")[:2]
        pairs.append((dst.rstrip("/"), str(Path(src).resolve())))
    pairs.sort(key=lambda p: -len(p[0]))          # longest container path first

    def tr(s):
        for dst, src in pairs:
            s = s.replace(dst + "/", src + "/")
            if s == dst or s.endswith("=" + dst) or s.endswith(" " + dst):
                s = s[: len(s) - len(dst)] + src
        return s

    env = dict(os.environ)
    env["PATH"] = FAKE_BIN + ":" + env.get("PATH", "")
    for e in opts["env"]:
        k, _, v = e.partition("=")
        env[k] = tr(v)
    cwd = tr(opts["pwd"]) if opts["pwd"] else None
    cmd = [tr(c) for c in cmd]
    prefix = ["unshare", "-rn"] if (opts["nonet"] and isolate_net) else []
    return subprocess.call(prefix + cmd, env=env, cwd=cwd)


def run(opts, cmd):
    cmd = no_login(cmd)
    m = mode()
    if m == "mount":
        return run_mount(opts, cmd)
    return run_translate(opts, cmd, isolate_net=(m == "translate"))


def main():
    argv = sys.argv[1:]
    if not argv:
        sys.exit("usage: apptainer exec|instance ...")
    if argv[0] == "fake-mode":
        print(mode()); return 0
    if argv[0] == "instance":
        if argv[1] == "start":
            opts, rest = parse(argv[2:])
            _image, name = rest
            (STATE / f"{name}.json").write_text(json.dumps(opts))
            return 0
        if argv[1] == "stop":
            (STATE / f"{argv[2]}.json").unlink(missing_ok=True)
            return 0
        sys.exit("fake apptainer: unsupported instance command")
    if argv[0] == "exec":
        opts, rest = parse(argv[1:])
        target, cmd = rest[0], rest[1:]
        if target.startswith("instance://"):
            f = STATE / f"{target[len('instance://'):]}.json"
            if not f.exists():
                sys.exit(f"fake apptainer: no instance {target}")
            base = json.loads(f.read_text())
            base["env"] += opts["env"]
            base["pwd"] = opts["pwd"] or base["pwd"]
            opts = base
        return run(opts, cmd)
    sys.exit(f"fake apptainer: unsupported command {argv[0]}")


if __name__ == "__main__":
    sys.exit(main())
